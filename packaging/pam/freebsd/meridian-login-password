# /etc/pam.d/meridian-login-password (FreeBSD)
#
# Username/password login stack for meridian-login on FreeBSD. Unlike the Linux
# stack this uses no pam_systemd (the compositor gets its seat from seatd, not
# logind) and no pam_u2f. FreeBSD's pam_unix has no session module, so the
# session uses pam_permit.
auth            required        pam_unix.so     no_warn
account         required        pam_unix.so
session         required        pam_permit.so
